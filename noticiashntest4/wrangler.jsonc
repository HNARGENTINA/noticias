{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noticias",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/noticias/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hn-argentina", "database_id": "9294fb4d-600f-48c1-9fc1-09b2e2a75301" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "079db4d33dd343bfad6baeab8a30b8fe" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0,30 * * * *", "15,45 * * * *", "20 * * * *", "5,35 * * * *", "10,40 * * * *"] },
  "observability": { "enabled": true }
}
